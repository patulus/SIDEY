<Window
    x:Class="Sidey.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sidey.App.Controls"
    xmlns:i18n="using:Sidey.App.Localization">
  <UserControl x:Name="MainRoot">
  <Grid Background="Transparent">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ResponsiveStates">
        <VisualState x:Name="Narrow">
          <VisualState.Setters>
            <Setter Target="HomePageContent.Padding" Value="24,20" />
            <Setter Target="GroupsPageContent.Padding" Value="24,20" />
            <Setter Target="StorePageContent.Padding" Value="24,20" />
            <Setter Target="SettingsPageContent.Padding" Value="24,20" />
            <Setter Target="AboutPageContent.Padding" Value="24,20" />
            <Setter Target="GroupCreateAction.(Grid.Row)" Value="1" />
            <Setter Target="GroupCreateAction.(Grid.Column)" Value="0" />
            <Setter Target="GroupCreateAction.HorizontalAlignment" Value="Right" />
            <Setter Target="GroupJoinAction.(Grid.Row)" Value="1" />
            <Setter Target="GroupJoinAction.(Grid.Column)" Value="0" />
            <Setter Target="GroupJoinAction.HorizontalAlignment" Value="Right" />
            <Setter Target="StoreFilterToggle.(Grid.Row)" Value="1" />
            <Setter Target="StoreFilterToggle.(Grid.Column)" Value="0" />
            <Setter Target="StoreFilterToggle.HorizontalAlignment" Value="Left" />
            <Setter Target="StoreFilterPanel.(Grid.Row)" Value="2" />
            <Setter Target="StoreFilterSearchColumn.Width" Value="*" />
            <Setter Target="StoreFilterSortColumn.Width" Value="0" />
            <Setter Target="StoreFilterOptionsColumn.Width" Value="0" />
            <Setter Target="StoreSortStack.(Grid.Row)" Value="1" />
            <Setter Target="StoreSortStack.(Grid.Column)" Value="0" />
            <Setter Target="StoreHideOwnedCheckBox.(Grid.Row)" Value="2" />
            <Setter Target="StoreHideOwnedCheckBox.(Grid.Column)" Value="0" />
            <Setter Target="StoreHideOwnedCheckBox.HorizontalAlignment" Value="Left" />
            <Setter Target="SoundControlsGrid.(Grid.Row)" Value="1" />
            <Setter Target="SoundControlsGrid.(Grid.Column)" Value="0" />
            <Setter Target="SoundControlsGrid.HorizontalAlignment" Value="Stretch" />
            <Setter Target="SoundSettingsLayout.RowSpacing" Value="12" />
            <Setter Target="EdgeControlColumn.Width" Value="0" />
            <Setter Target="EdgeComboBox.(Grid.Row)" Value="1" />
            <Setter Target="EdgeComboBox.(Grid.Column)" Value="0" />
            <Setter Target="SpanControlColumn.Width" Value="0" />
            <Setter Target="SpanComboBox.(Grid.Row)" Value="1" />
            <Setter Target="SpanComboBox.(Grid.Column)" Value="0" />
            <Setter Target="MonitorControlColumn.Width" Value="0" />
            <Setter Target="MonitorComboBox.(Grid.Row)" Value="1" />
            <Setter Target="MonitorComboBox.(Grid.Column)" Value="0" />
            <Setter Target="LanguageDescription.(Grid.Row)" Value="0" />
            <Setter Target="LanguageDescription.(Grid.Column)" Value="1" />
            <Setter Target="LanguageControlColumn.Width" Value="0" />
            <Setter Target="LanguageSettingsLayout.RowSpacing" Value="12" />
            <Setter Target="LanguageComboBox.(Grid.Row)" Value="1" />
            <Setter Target="LanguageComboBox.(Grid.Column)" Value="1" />
            <Setter Target="ThemeDescription.(Grid.Row)" Value="0" />
            <Setter Target="ThemeDescription.(Grid.Column)" Value="1" />
            <Setter Target="ThemeControlColumn.Width" Value="0" />
            <Setter Target="ThemeSettingsLayout.RowSpacing" Value="12" />
            <Setter Target="ThemeComboBox.(Grid.Row)" Value="1" />
            <Setter Target="ThemeComboBox.(Grid.Column)" Value="1" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Standard" />
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border x:Name="MainFallbackBackground" Grid.RowSpan="2" Canvas.ZIndex="-1"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />
    <TitleBar
        x:Name="AppTitleBar"
        Grid.Row="0"
        BackRequested="OnTitleBarBackRequested"
        IsBackButtonEnabled="False"
        IsBackButtonVisible="True"
        IsPaneToggleButtonVisible="True"
        PaneToggleRequested="OnTitleBarPaneToggleRequested"
        Title="SIDEY" />
    <NavigationView
        x:Name="RootNavigation"
        Grid.Row="1"
        Background="Transparent"
        CompactModeThresholdWidth="0"
        CompactPaneLength="48"
        ExpandedModeThresholdWidth="960"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="210"
        PaneDisplayMode="Auto"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.profile}, Mode=OneWay}" Icon="Contact" Tag="profile" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.profile}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.groups}, Mode=OneWay}" Icon="People" Tag="groups" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.groups}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.store}, Mode=OneWay}" Icon="Shop" Tag="store" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.store}, Mode=OneWay}" />
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.settings}, Mode=OneWay}" Icon="Setting" Tag="settings" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.settings}, Mode=OneWay}" />
        <NavigationViewItem Content="{Binding Value, Source={i18n:I18n Key=navigation.about}, Mode=OneWay}" Tag="about" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=navigation.about}, Mode=OneWay}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Grid x:Name="PageViewport" SizeChanged="OnPageViewportSizeChanged">
        <Grid>
          <ScrollViewer x:Name="HomePage" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="HomePageContent" Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch" Spacing="24">
              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=profile.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.description}, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel x:Name="ProfileCardContent" Spacing="20">
                  <controls:ResponsiveFormPanel x:Name="ProfileNameLayout">
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.nickname}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.nicknameDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ProfileNameEditor" Spacing="8">
                      <TextBox MaxLength="8" PlaceholderText="{Binding Value, Source={i18n:I18n Key=onboarding.nicknamePlaceholder}, Mode=OneWay}" Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <Button
                          Command="{Binding SaveProfileCommand}"
                          Content="{Binding Value, Source={i18n:I18n Key=profile.changeNickname}, Mode=OneWay}"
                          HorizontalAlignment="Right"
                          Style="{StaticResource AccentButtonStyle}"
                          ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=profile.changeNicknameTooltip}, Mode=OneWay}"
                          Visibility="{Binding HasNicknameChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                  </controls:ResponsiveFormPanel>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.character}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.characterDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel>
                    <GridView
                      x:Name="CharacterSelector"
                      IsEnabled="{Binding IsSavingCharacter, Converter={StaticResource InverseBooleanConverter}}"
                      ItemsSource="{Binding CharacterSelections}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCharacterId, Mode=TwoWay}"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled" HorizontalAlignment="Stretch">
                    <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:ResponsiveSelectionPanel MaximumColumns="5" MinimumItemWidth="128" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding SelectionStatus}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="GridViewItem">
                              <ListViewItemPresenter CornerRadius="8" ContentMargin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Control.IsTemplateFocusTarget="True" FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                  FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}" FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                  FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}" FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                  SelectionCheckMarkVisualEnabled="False" SelectedBorderThickness="0"
                                  PointerOverBackground="{ThemeResource SubtleButtonBackgroundPointerOver}" SelectedPointerOverBackground="{ThemeResource SubtleButtonBackgroundPointerOver}"
                                  PressedBackground="{ThemeResource SubtleButtonBackgroundPressed}" SelectedPressedBackground="{ThemeResource SubtleButtonBackgroundPressed}"
                                  SelectedBackground="Transparent" SelectedDisabledBackground="Transparent"
                                  PointerOverBorderBrush="Transparent" SelectedBorderBrush="Transparent" SelectedPointerOverBorderBrush="Transparent"
                                  SelectedPressedBorderBrush="Transparent" SelectedDisabledBorderBrush="Transparent" SelectedInnerBorderBrush="Transparent"
                                  DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Grid MinHeight="116" HorizontalAlignment="Stretch">
                          <controls:SelectionProgress Canvas.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" IsPending="{Binding IsPending}" AnimationsEnabled="{Binding AnimationsEnabled}" />
                          <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="8" Spacing="8">
                            <Border Width="48" Height="48" HorizontalAlignment="Center">
                              <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Stretch" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border
                              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                              BorderThickness="1.5"
                              CornerRadius="8"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Border
                              Width="24"
                              Height="24"
                              Margin="8"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Background="{ThemeResource AccentFillColorDefaultBrush}"
                              CornerRadius="12"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE73E;" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                    </GridView>
                    <controls:ResponsiveSelectionPanel x:Name="CharacterSkeleton" MaximumColumns="5" MinimumItemWidth="128" IsHitTestVisible="False" Visibility="{Binding IsCharacterSelectionsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="48" Height="48" HorizontalAlignment="Center" /><controls:SkeletonBar Width="58" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="48" Height="48" HorizontalAlignment="Center" /><controls:SkeletonBar Width="68" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="48" Height="48" HorizontalAlignment="Center" /><controls:SkeletonBar Width="52" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="48" Height="48" HorizontalAlignment="Center" /><controls:SkeletonBar Width="64" Height="12" HorizontalAlignment="Center" /></StackPanel>
                    </controls:ResponsiveSelectionPanel>
                  </StackPanel>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.bubble}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.bubbleDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel>
                    <GridView
                      x:Name="BubbleSelector"
                      ItemsSource="{Binding BubbleSelections}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled" HorizontalAlignment="Stretch">
                    <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:ResponsiveSelectionPanel MaximumColumns="4" MinimumItemWidth="128" FillAvailableWidth="True" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="GridViewItem">
                              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Button MinHeight="116" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding SelectCommand}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.ItemStatus="{Binding SelectionStatus}" Style="{StaticResource SubtleButtonStyle}" CornerRadius="8">
                          <Grid MinHeight="116">
                            <controls:SelectionProgress Canvas.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" IsPending="{Binding IsPending}" AnimationsEnabled="{Binding AnimationsEnabled}" />
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="8" Spacing="8">
                              <controls:StoreProductArtwork Height="58" ProductKind="{Binding Kind}" CatalogItemId="{Binding CatalogItemId}" CharacterId="{Binding CharacterId}" />
                              <TextBlock MinHeight="32" HorizontalAlignment="Stretch" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="8" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border
                                Width="24"
                                Height="24"
                                Margin="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="12"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <FontIcon
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  Glyph="&#xE73E;" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                    </GridView>
                    <controls:ResponsiveSelectionPanel x:Name="BubbleSkeleton" MaximumColumns="4" MinimumItemWidth="128" FillAvailableWidth="True" IsHitTestVisible="False" Visibility="{Binding IsBubbleSelectionsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="70" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="58" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="70" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="72" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="70" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="62" Height="12" HorizontalAlignment="Center" /></StackPanel>
                    </controls:ResponsiveSelectionPanel>
                  </StackPanel>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=profile.throwable}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.throwableDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel>
                    <GridView
                      x:Name="ThrowableSelector"
                      ItemsSource="{Binding ThrowableSelections}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled" HorizontalAlignment="Stretch">
                    <GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:ResponsiveSelectionPanel MaximumColumns="4" MinimumItemWidth="128" FillAvailableWidth="True" />
                      </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                      <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="GridViewItem">
                              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                      <DataTemplate>
                        <Button MinHeight="116" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding SelectCommand}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.ItemStatus="{Binding SelectionStatus}" Style="{StaticResource SubtleButtonStyle}" CornerRadius="8">
                          <Grid MinHeight="116">
                            <controls:SelectionProgress Canvas.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" IsPending="{Binding IsPending}" AnimationsEnabled="{Binding AnimationsEnabled}" />
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="8" Spacing="8">
                              <controls:StoreProductArtwork Height="58" ProductKind="{Binding Kind}" CatalogItemId="{Binding CatalogItemId}" CharacterId="{Binding CharacterId}" />
                              <TextBlock MinHeight="32" HorizontalAlignment="Stretch" Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="8" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border
                                Width="24"
                                Height="24"
                                Margin="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="12"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <FontIcon
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  Glyph="&#xE73E;" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </GridView.ItemTemplate>
                    </GridView>
                    <controls:ResponsiveSelectionPanel x:Name="ThrowableSkeleton" MaximumColumns="4" MinimumItemWidth="128" FillAvailableWidth="True" IsHitTestVisible="False" Visibility="{Binding IsThrowableSelectionsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="58" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="58" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="58" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="72" Height="12" HorizontalAlignment="Center" /></StackPanel>
                      <StackPanel VerticalAlignment="Center" Spacing="12"><controls:SkeletonBar Width="58" Height="50" HorizontalAlignment="Center" /><controls:SkeletonBar Width="62" Height="12" HorizontalAlignment="Center" /></StackPanel>
                    </controls:ResponsiveSelectionPanel>
                  </StackPanel>
                  <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=profile.duplicateNotice}, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="GroupsPage" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
            <Grid x:Name="GroupsPageViewportHost">
              <StackPanel x:Name="GroupsPageContent" Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch" Spacing="24">
              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.description}, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <Grid>
                <Grid Visibility="{Binding IsRoomsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <Grid.Transitions>
                    <TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" /></TransitionCollection>
                  </Grid.Transitions>
                  <Border Style="{StaticResource SideySettingsCardStyle}" Visibility="{Binding HasRooms, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                  <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <SymbolIcon HorizontalAlignment="Center" Symbol="People" />
                    <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.emptyTitle}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.emptyDescription}, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  </Border>
                  <ListView IsItemClickEnabled="False" ItemsSource="{Binding Rooms}" SelectionMode="None" Visibility="{Binding HasRooms, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                      <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ContentThemeTransition VerticalOffset="8" />
                        <ReorderThemeTransition />
                      </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="0" Style="{StaticResource SideySettingsCardStyle}">
                          <StackPanel Spacing="0">
                          <StackPanel.Transitions>
                            <TransitionCollection>
                              <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
                              <RepositionThemeTransition />
                            </TransitionCollection>
                          </StackPanel.Transitions>
                          <Grid
                              Padding="20"
                              Background="Transparent"
                              ColumnSpacing="12"
                              PointerEntered="OnRoomHeaderPointerEntered"
                              PointerExited="OnRoomHeaderPointerExited">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="RoomHeaderHoverBackground"
                                Grid.ColumnSpan="3"
                                Margin="-20"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Button
                                Grid.ColumnSpan="3"
                                Margin="-20"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{Binding ExpansionActionText}"
                                Click="OnRoomHeaderClick"
                                Tag="{Binding ElementName=RoomExpandedBody}"
                                ToolTipService.ToolTip="{Binding ExpansionActionText}">
                              <Button.Style>
                                <Style TargetType="Button">
                                  <Setter Property="Background" Value="Transparent" />
                                  <Setter Property="BorderBrush" Value="Transparent" />
                                  <Setter Property="BorderThickness" Value="0" />
                                  <Setter Property="CornerRadius" Value="8" />
                                  <Setter Property="UseSystemFocusVisuals" Value="True" />
                                  <Setter Property="Template">
                                    <Setter.Value>
                                      <ControlTemplate TargetType="Button">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{TemplateBinding CornerRadius}" />
                                      </ControlTemplate>
                                    </Setter.Value>
                                  </Setter>
                                </Style>
                              </Button.Style>
                            </Button>
                            <Grid Grid.ColumnSpan="2" ColumnSpacing="12" IsHitTestVisible="False">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                <SymbolIcon Symbol="People" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <SymbolIcon Symbol="People" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              </Grid>
                              <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Details}" />
                              </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <TextBlock IsHitTestVisible="False" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.active}, Mode=OneWay}" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <ProgressRing Width="20" Height="20" IsActive="{Binding IsSwitching}" IsHitTestVisible="False" Visibility="{Binding IsSwitching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding JoinCommand}" Content="{Binding JoinActionText}" IsEnabled="{Binding IsJoinEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.joinTooltip}, Mode=OneWay}" Visibility="{Binding CanJoin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding InviteCommand}" IsEnabled="{Binding IsInviteActionEnabled}" ToolTipService.ToolTip="{Binding InviteActionText}">
                                <Grid>
                                  <TextBlock Text="{Binding InviteActionText}" Visibility="{Binding IsInviteCopyConfirmed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                  <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding IsInviteCopyConfirmed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                    <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{Binding InviteActionText}" />
                                  </StackPanel>
                                </Grid>
                              </Button>
                              <FontIcon
                                  x:Name="RoomExpansionChevron"
                                  Width="32"
                                  Height="32"
                                  FontSize="12"
                                  Glyph="&#xE70D;"
                                  IsHitTestVisible="False"
                                  Loaded="OnRoomExpansionChevronLoaded"
                                  RenderTransformOrigin="0.5,0.5"
                                  ToolTipService.ToolTip="{Binding ExpansionActionText}">
                                <FontIcon.RenderTransform><RotateTransform /></FontIcon.RenderTransform>
                              </FontIcon>
                            </StackPanel>
                          </Grid>

                          <Grid x:Name="RoomExpandedBody" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RenderTransform>
                              <TranslateTransform />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Row="1" Padding="72,16,20,20" Spacing="12">
                              <ItemsControl ItemsSource="{Binding Members}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid MinHeight="44" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="40" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36">
                                      <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                      <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="♛" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                      <TextBlock VerticalAlignment="Center" Text="{Binding Nickname}" />
                                      <Border
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Background="{ThemeResource SideyAccentBackground12Brush}"
                                          CornerRadius="12"
                                          Visibility="{Binding IsCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Margin="0,-1,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SideyAccentForegroundBrush}"
                                            Text="{Binding Value, Source={i18n:I18n Key=common.me}, Mode=OneWay}" />
                                      </Border>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding RemoveCommand}" Content="{Binding Value, Source={i18n:I18n Key=groups.removeMember}, Mode=OneWay}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.removeMemberTooltip}, Mode=OneWay}" Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Command="{Binding LeaveCommand}" Content="{Binding Value, Source={i18n:I18n Key=groups.leave}, Mode=OneWay}" IsEnabled="{Binding AreRoomActionsEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.leaveTooltip}, Mode=OneWay}" />
                              <Button Command="{Binding RenameCommand}" Content="{Binding Value, Source={i18n:I18n Key=groups.rename}, Mode=OneWay}" IsEnabled="{Binding AreOwnerActionsEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.renameTooltip}, Mode=OneWay}" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Button Command="{Binding DeleteCommand}" Content="{Binding Value, Source={i18n:I18n Key=groups.delete}, Mode=OneWay}" IsEnabled="{Binding AreOwnerActionsEnabled}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.deleteTooltip}, Mode=OneWay}" Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Grid>
                <StackPanel x:Name="RoomsSkeleton" Spacing="12" Visibility="{Binding IsRoomsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Border Height="86" Style="{StaticResource SideySettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                      <controls:SkeletonBar Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8"><controls:SkeletonBar MaxWidth="120" Height="14" /><controls:SkeletonBar MaxWidth="190" Height="12" /></StackPanel>
                      <controls:SkeletonBar Grid.Column="2" Height="32" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Height="86" Style="{StaticResource SideySettingsCardStyle}">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                      <controls:SkeletonBar Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8"><controls:SkeletonBar MaxWidth="104" Height="14" /><controls:SkeletonBar MaxWidth="176" Height="12" /></StackPanel>
                      <controls:SkeletonBar Grid.Column="2" Height="32" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="8">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.createTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.createDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="12" RowSpacing="12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Header="{Binding Value, Source={i18n:I18n Key=groups.roomName}, Mode=OneWay}" IsEnabled="{Binding AreGroupMutationsEnabled}" MaxLength="20" PlaceholderText="{Binding Value, Source={i18n:I18n Key=groups.roomNamePlaceholder}, Mode=OneWay}" Text="{Binding CreateRoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button x:Name="GroupCreateAction" Grid.Column="1" Command="{Binding CreateRoomCommand}" Content="{Binding CreateRoomActionText}" IsEnabled="{Binding AreGroupMutationsEnabled}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.createTooltip}, Mode=OneWay}" />
                </Grid>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=groups.joinTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=groups.joinDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="12" RowSpacing="12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Header="{Binding Value, Source={i18n:I18n Key=groups.inviteCode}, Mode=OneWay}" IsEnabled="{Binding AreGroupMutationsEnabled}" PlaceholderText="{Binding Value, Source={i18n:I18n Key=groups.inviteCode}, Mode=OneWay}" Text="{Binding InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button x:Name="GroupJoinAction" Grid.Column="1" Command="{Binding JoinRoomCommand}" Content="{Binding JoinRoomActionText}" IsEnabled="{Binding AreGroupMutationsEnabled}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=groups.joinByCodeTooltip}, Mode=OneWay}" />
                </Grid>
              </Border>

              </StackPanel>
            </Grid>
          </ScrollViewer>

          <ScrollViewer x:Name="StorePage" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
            <Grid x:Name="StorePageViewportHost">
              <StackPanel x:Name="StorePageContent" Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch" Spacing="24">
              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=store.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=store.description}, Mode=OneWay}" />
              </StackPanel>
              <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <RadioButton
                      x:Name="StoreCharacterKindChip"
                      AutomationProperties.AutomationId="StoreCharacterKindChip"
                      Checked="OnStoreKindChipChecked"
                      Content="{Binding Value, Source={i18n:I18n Key=store.kindCharacter}, Mode=OneWay}"
                      GroupName="StoreProductKind"
                      IsChecked="True"
                      Style="{StaticResource SideyStoreKindChipSelectedStyle}"
                      Tag="0" />
                  <RadioButton
                      x:Name="StoreBubbleKindChip"
                      AutomationProperties.AutomationId="StoreBubbleKindChip"
                      Checked="OnStoreKindChipChecked"
                      Content="{Binding Value, Source={i18n:I18n Key=store.kindBubble}, Mode=OneWay}"
                      GroupName="StoreProductKind"
                      Style="{StaticResource SideyStoreKindChipStyle}"
                      Tag="1" />
                  <RadioButton
                      x:Name="StoreThrowableKindChip"
                      AutomationProperties.AutomationId="StoreThrowableKindChip"
                      Checked="OnStoreKindChipChecked"
                      Content="{Binding Value, Source={i18n:I18n Key=store.kindThrowable}, Mode=OneWay}"
                      GroupName="StoreProductKind"
                      Style="{StaticResource SideyStoreKindChipStyle}"
                      Tag="2" />
                </StackPanel>
                <ToggleButton
                    x:Name="StoreFilterToggle"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="StoreFilterToggle"
                    Click="OnStoreFilterToggleClick"
                    Style="{StaticResource SideyStoreFilterToggleStyle}"
                    ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=store.filter}, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE71C;" />
                    <TextBlock Text="{Binding Value, Source={i18n:I18n Key=store.filter}, Mode=OneWay}" />
                    <FontIcon x:Name="StoreFilterChevron" FontSize="12" Glyph="&#xE70D;" RenderTransformOrigin="0.5,0.5">
                      <FontIcon.RenderTransform><RotateTransform /></FontIcon.RenderTransform>
                    </FontIcon>
                  </StackPanel>
                </ToggleButton>
                <Border
                    x:Name="StoreFilterPanel"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Padding="16"
                    Style="{StaticResource SideySettingsCardStyle}"
                    Visibility="Collapsed">
                  <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                  <Grid x:Name="StoreFilterLayout" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition x:Name="StoreFilterSearchColumn" Width="300" />
                      <ColumnDefinition x:Name="StoreFilterSortColumn" Width="180" />
                      <ColumnDefinition x:Name="StoreFilterOptionsColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                      <TextBox
                          x:Name="StoreSearchTextBox"
                          AutomationProperties.AutomationId="StoreSearchTextBox"
                          Header="{Binding Value, Source={i18n:I18n Key=store.search}, Mode=OneWay}"
                          PlaceholderText="{Binding Value, Source={i18n:I18n Key=store.searchPlaceholder}, Mode=OneWay}"
                          Text="{Binding StoreSearchText, Mode=OneWay}"
                          TextChanged="OnStoreSearchTextChanged" />
                      <Button
                          x:Name="StoreResetFiltersButton"
                          HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="StoreResetFiltersButton"
                          Click="OnResetStoreFiltersClick"
                          Content="{Binding Value, Source={i18n:I18n Key=store.resetAll}, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel x:Name="StoreSortStack" Grid.Column="1" Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=store.sort}, Mode=OneWay}" />
                      <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedStoreSortIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=store.sortCatalog}, Mode=OneWay}" />
                        <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=store.sortPriceAscending}, Mode=OneWay}" />
                        <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=store.sortPriceDescending}, Mode=OneWay}" />
                      </ComboBox>
                    </StackPanel>
                    <CheckBox
                        x:Name="StoreHideOwnedCheckBox"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Content="{Binding Value, Source={i18n:I18n Key=store.hideOwned}, Mode=OneWay}"
                        IsChecked="{Binding HidesOwnedStoreProducts, Mode=TwoWay}" />
                  </Grid>
                </Border>
              </Grid>
              <Grid x:Name="StoreResultsHost" MinHeight="220">
                <Grid Visibility="{Binding IsStoreLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <Grid.Transitions>
                    <TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" /></TransitionCollection>
                  </Grid.Transitions>
                  <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding HasVisibleStoreProducts, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <FontIcon HorizontalAlignment="Center" FontSize="28" Glyph="&#xE735;" />
                  <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=store.emptyTitle}, Mode=OneWay}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=store.emptyDescription}, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsRepeater
                    x:Name="StoreProductRepeater"
                    ItemsSource="{Binding VisibleStoreProducts}"
                    Visibility="{Binding HasVisibleStoreProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ItemsRepeater.Layout>
                    <controls:StoreProductGridLayout />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                      <Button
                          MinHeight="224"
                          Padding="12"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          AutomationProperties.Name="{Binding DisplayName}"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          Command="{Binding PreviewCommand}"
                          CornerRadius="8"
                          ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=store.openPreview}, Mode=OneWay}">
                        <Grid RowSpacing="8">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="116" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Border Background="{ThemeResource SideyAccentBackground10Brush}" CornerRadius="12">
                            <Grid>
                              <controls:StoreProductArtwork
                                  Margin="12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ProductKind="{Binding Kind}"
                                  CatalogItemId="{Binding CatalogItemId}"
                                  CharacterId="{Binding CharacterId}" />
                              <Border
                                  Margin="8"
                                  Padding="8,4"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  CornerRadius="12"
                                  Visibility="{Binding IsPreviewOnlyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <FontIcon FontSize="12" Glyph="&#xE72E;" />
                                </StackPanel>
                              </Border>
                            </Grid>
                          </Border>
                          <TextBlock
                              Grid.Row="1"
                              AutomationProperties.AutomationId="StoreProductName"
                              HorizontalAlignment="Stretch"
                              FontSize="14"
                              FontWeight="SemiBold"
                              MaxLines="2"
                              MinHeight="40"
                              Text="{Binding DisplayName}"
                              TextAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              TextWrapping="Wrap"
                              ToolTipService.ToolTip="{Binding DisplayName}" />
                          <TextBlock
                              Grid.Row="2"
                              AutomationProperties.AutomationId="StoreProductPrice"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              FontSize="12"
                              Text="{Binding FormattedPrice}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </Grid>
                <ItemsRepeater x:Name="StoreSkeletonRepeater"
                    ItemsSource="{Binding VisibleStoreProducts}"
                    Visibility="{Binding IsStoreLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ItemsRepeater.Layout><controls:StoreProductGridLayout /></ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                      <Border MinHeight="224" Padding="12" Style="{StaticResource SideySettingsCardStyle}">
                        <Grid RowSpacing="8">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="116" /><RowDefinition Height="40" /><RowDefinition Height="16" />
                          </Grid.RowDefinitions>
                          <controls:SkeletonBar />
                          <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Center">
                            <controls:SkeletonBar Width="92" Height="14" HorizontalAlignment="Center" />
                            <controls:SkeletonBar Width="68" Height="14" HorizontalAlignment="Center" />
                          </StackPanel>
                          <controls:SkeletonBar Grid.Row="2" Width="54" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </Grid>
              <TextBlock
                  HorizontalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{Binding Value, Source={i18n:I18n Key=store.comingSoonDescription}, Mode=OneWay}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <ScrollViewer x:Name="SettingsPage" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
            <StackPanel x:Name="SettingsPageContent" Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch" Spacing="20">
              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.generalTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.generalDescription}, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="16">
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.overlay}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.overlayDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding IsOverlayVisible, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.overlayTooltip}, Mode=OneWay}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.startup}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.startupDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding StartAtLogin, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.startupTooltip}, Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.displayTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.displayDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="16">
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.quietMode}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.quietModeDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding IsQuietMode, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.quietModeTooltip}, Mode=OneWay}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.rightClickThrow}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.rightClickThrowDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding RequiresRightClickToThrow, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.rightClickThrowTooltip}, Mode=OneWay}" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.offlineMembers}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.offlineMembersDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" HorizontalAlignment="Right" IsOn="{Binding ShowOfflineMembers, Mode=TwoWay}" VerticalAlignment="Center" OffContent="" OnContent="" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.offlineMembersTooltip}, Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.soundTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Value, Source={i18n:I18n Key=settings.soundDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border x:Name="SoundSettingsCard" Style="{StaticResource SideySettingsCardStyle}">
                <Grid x:Name="SoundSettingsLayout" ColumnSpacing="16" RowSpacing="0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.characterSounds}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Value, Source={i18n:I18n Key=settings.characterSoundsDescription}, Mode=OneWay}" />
                  </StackPanel>
                  <Grid x:Name="SoundControlsGrid" Grid.Column="1" Width="340" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="SoundMuteButton" Width="36" Height="36" Padding="0" VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}" Command="{Binding ToggleCharacterSoundMuteCommand}"
                        ToolTipService.ToolTip="{Binding SoundMuteActionText}" AutomationProperties.Name="{Binding SoundMuteActionText}">
                      <Grid>
                        <SymbolIcon Symbol="Volume" Visibility="{Binding CharacterSoundEffectsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <SymbolIcon Symbol="Mute" Visibility="{Binding CharacterSoundEffectsEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                      </Grid>
                    </Button>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding CharacterSoundVolumeLabel}" />
                    <controls:SoundVolumeSlider x:Name="CharacterSoundVolumeSlider" Style="{StaticResource DefaultSliderStyle}" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10" Value="{Binding CharacterSoundEffectsVolume, Mode=TwoWay}" AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=settings.soundVolume}, Mode=OneWay}" />
                  </Grid>
                </Grid>
              </Border>
              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.worldTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.worldDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <StackPanel Spacing="12">
                  <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="EdgeControlColumn" Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.edge}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.edgeDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="EdgeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedEdgeIndex, Mode=TwoWay}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.edgeTooltip}, Mode=OneWay}">
                      <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.edgeBottom}, Mode=OneWay}" /><ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.edgeLeft}, Mode=OneWay}" /><ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.edgeRight}, Mode=OneWay}" /><ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.edgeTop}, Mode=OneWay}" />
                    </ComboBox>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SpanControlColumn" Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.span}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.spanDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="SpanComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSpanIndex, Mode=TwoWay}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.spanTooltip}, Mode=OneWay}">
                      <ComboBoxItem Content="1/3" /><ComboBoxItem Content="1/2" /><ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.spanFull}, Mode=OneWay}" />
                    </ComboBox>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="MonitorControlColumn" Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.monitor}, Mode=OneWay}" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.monitorDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="MonitorComboBox" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{Binding Monitors}" SelectedValue="{Binding SelectedMonitorIdentifier, Mode=TwoWay}" SelectedValuePath="Identifier" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.monitorTooltip}, Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SideySettingsCardStyle}" Visibility="{Binding IsValidationMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="8">
                  <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.rendererMetrics}, Mode=OneWay}" />
                  <TextBlock Text="{Binding ValidationMetricsText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ValidationPathText}" TextWrapping="Wrap" />
                  <Button Command="{Binding ExportValidationMetricsCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.exportMetrics}, Mode=OneWay}" HorizontalAlignment="Left" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.exportMetricsTooltip}, Mode=OneWay}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="AboutPage" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Visibility="Collapsed">
            <StackPanel x:Name="AboutPageContent" Padding="32,24" MaxWidth="820" HorizontalAlignment="Stretch" Spacing="20">
              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=about.title}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=about.description}, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>

              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding IsConnected, Converter={StaticResource ConnectionBrushConverter}}" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ConnectionText}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding RetryConnectionCommand}" Content="{Binding Value, Source={i18n:I18n Key=connection.retry}, Mode=OneWay}" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=connection.retry}, Mode=OneWay}" />
                </Grid>
              </Border>

              <Border Padding="20,16" Style="{StaticResource SideySettingsCardStyle}">
                <Grid x:Name="LanguageSettingsLayout" ColumnSpacing="16" RowSpacing="0" VerticalAlignment="Center">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LanguageControlColumn" Width="220" /></Grid.ColumnDefinitions>
                  <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="24" Glyph="&#xF2B7;" VerticalAlignment="Center" />
                  <StackPanel x:Name="LanguageDescription" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.language}, Mode=OneWay}" />
                    <TextBlock x:Name="LanguageDescriptionText" Text="{Binding Value, Source={i18n:I18n Key=settings.languageDescription}, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <ComboBox x:Name="LanguageComboBox" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=settings.language}, Mode=OneWay}" IsEnabled="{Binding IsLanguageSelectionEnabled}" SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="한국어" />
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="日本語" />
                    <ComboBoxItem Content="简体中文" />
                    <ComboBoxItem Content="繁體中文" />
                    <ComboBoxItem Content="Українська" />
                    <ComboBoxItem Content="Русский" />
                  </ComboBox>
                </Grid>
              </Border>

              <Border Padding="20,16" Style="{StaticResource SideySettingsCardStyle}">
                <Grid x:Name="ThemeSettingsLayout" ColumnSpacing="16" RowSpacing="0" VerticalAlignment="Center">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ThemeControlColumn" Width="220" /></Grid.ColumnDefinitions>
                  <FontIcon FontSize="24" Glyph="&#xE790;" VerticalAlignment="Center" />
                  <StackPanel x:Name="ThemeDescription" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=settings.theme}, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="0"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenExternalLinkCommand}"
                        CommandParameter="ms-settings:colors"
                        Content="{Binding Value, Source={i18n:I18n Key=settings.themeDescription}, Mode=OneWay}" />
                  </StackPanel>
                  <ComboBox
                      x:Name="ThemeComboBox"
                      Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=settings.theme}, Mode=OneWay}"
                      IsEnabled="{Binding IsThemeSelectionEnabled}"
                      SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.themeSystem}, Mode=OneWay}" />
                    <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.themeLight}, Mode=OneWay}" />
                    <ComboBoxItem Content="{Binding Value, Source={i18n:I18n Key=settings.themeDark}, Mode=OneWay}" />
                  </ComboBox>
                </Grid>
              </Border>

              <StackPanel x:Name="UpdateSection" Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.updateTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.updateDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <FontIcon FontSize="22" Glyph="&#xE895;" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding CurrentVersionText}" />
                    <Grid>
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding LastUpdateCheckText}" Visibility="{Binding HasUpdateActivity, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding HasUpdateActivity, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressRing Width="16" Height="16" IsActive="{Binding HasUpdateActivity}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding UpdateActivityText}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                    <HyperlinkButton HorizontalAlignment="Left" Padding="0" Command="{Binding OpenReleaseNotesCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.releaseNotes}, Mode=OneWay}" />
                  </StackPanel>
                  <Button Grid.Column="2" Command="{Binding CheckForUpdatesCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.checkUpdate}, Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.checkNowTooltip}, Mode=OneWay}" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <FontIcon FontSize="22" Glyph="&#xE90F;" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=about.diagnosticsTitle}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=about.diagnosticsDescription}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding ExportDiagnosticDataCommand}" Content="{Binding Value, Source={i18n:I18n Key=about.exportDiagnostics}, Mode=OneWay}" />
                </Grid>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=about.policiesTitle}, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=about.policiesDescription}, Mode=OneWay}" />
              </StackPanel>
              <Border Style="{StaticResource SideySettingsCardStyle}" Padding="8">
                <StackPanel Spacing="0">
                  <Button Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}" Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://sidey-app.github.io/SIDEY/terms/">
                    <Grid><TextBlock Text="{Binding Value, Source={i18n:I18n Key=about.terms}, Mode=OneWay}" /><FontIcon HorizontalAlignment="Right" Glyph="&#xE8A7;" /></Grid>
                  </Button>
                  <Rectangle Height="1" Margin="12,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Button Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}" Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://sidey-app.github.io/SIDEY/privacy/">
                    <Grid><TextBlock Text="{Binding Value, Source={i18n:I18n Key=about.privacy}, Mode=OneWay}" /><FontIcon HorizontalAlignment="Right" Glyph="&#xE8A7;" /></Grid>
                  </Button>
                  <Rectangle Height="1" Margin="12,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Button Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}" Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://sidey-app.github.io/SIDEY/refund/">
                    <Grid><TextBlock Text="{Binding Value, Source={i18n:I18n Key=about.refund}, Mode=OneWay}" /><FontIcon HorizontalAlignment="Right" Glyph="&#xE8A7;" /></Grid>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Margin="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SideyInAppNoticeBackgroundBrush}"
            IsClosable="True"
            IsOpen="False" />
      </Grid>
    </NavigationView>
  </Grid>
  </UserControl>
</Window>
